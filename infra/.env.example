# 이 파일을 .env 로 복사해서 채운다. .env 는 저장소에 올리지 않는다.

# DuckDNS 등에서 만든 서버 주소. 서버 고정 IP 를 가리켜야 인증서가 발급된다.
DOMAIN=goldensign.duckdns.org

# infra/models/ 에 둔 인식 모델 파일명.
RECOGNITION_MODEL_FILENAME=sign_transformer_test_yewon.keras
RECOGNITION_CONFIDENCE_THRESHOLD=0.7
RECOGNITION_MARGIN_THRESHOLD=0.15

# 앱에 돌려주는 WebSocket 주소. Caddy 뒤라 --proxy-headers 로도 wss:// 가
# 나오지만, 명시해 두면 프록시 설정과 상관없이 고정된다.
PUBLIC_WS_BASE_URL=wss://goldensign.duckdns.org

# MediaPipe 랜드마커 세트 수. 서버 vCPU 수와 같게 둔다 (2 vCPU -> 2).
KEYPOINT_WORKERS=2
